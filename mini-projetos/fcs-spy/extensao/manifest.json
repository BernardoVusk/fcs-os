{
  "manifest_version": 3,
  "name": "FCS SPY",
  "version": "0.1.0",
  "description": "Estudo de mercado e produto na Shopee, da FCS 3D STUDIO.",
  "permissions": ["storage", "unlimitedStorage"],
  "options_page": "opcoes.html",
  "content_scripts": [
    {
      "matches": ["https://shopee.com.br/*"],
      "js": ["escuta.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://shopee.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
