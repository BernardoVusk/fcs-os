{
  "manifest_version": 3,
  "name": "FCS SPY",
  "version": "0.1.0",
  "description": "Estudo de mercado e produto na Shopee, da FCS 3D STUDIO.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "options_page": "opcoes.html",
  "action": { "default_title": "FCS SPY: custos e configurações" },
  "background": { "service_worker": "fundo.js" },
  "content_scripts": [
    {
      "matches": ["https://shopee.com.br/*"],
      "js": ["escuta.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://shopee.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://seller.shopee.com.br/*"],
      "js": ["escuta-vendedor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://seller.shopee.com.br/*"],
      "js": ["vendedor.js"],
      "run_at": "document_start"
    }
  ]
}
