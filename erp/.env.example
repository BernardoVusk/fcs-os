# Runtime da aplicação. Copiar para erp/.env.local (nunca versionar).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
# Só no servidor: criação de usuários. Nunca em NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
# Usuário dos testes e2e (criar com ferramentas/criar-usuario.mjs)
E2E_EMAIL=
E2E_SENHA=
# Link de convite do grupo do WhatsApp mostrado na página pública /sorteio (não é segredo).
SORTEIO_WHATSAPP_URL=
# Grupos de Ofertas: chave AES-256 (32 bytes em base64) das credenciais de afiliado e sessões do WhatsApp.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# A mesma chave vai na Vercel e na Fly. Guardar uma cópia fora do computador: sem ela, nada cifrado abre.
OFERTAS_CHAVE_CRIPTO=
# Só durante uma troca de chave: a chave antiga, para abrir o que foi cifrado com ela.
# OFERTAS_CHAVE_CRIPTO_ANTERIOR=
