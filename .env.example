# Copie pra .env na raiz e preencha. O .env nunca vai pro git.
#
#   cp .env.example .env

# --- Geração de imagem (skill /carrossel com foto IA) ---
OPENAI_API_KEY=sk-...

# --- Publicação automática (skill /aprovar-post) ---
# Token de longa duração da Página do Facebook
META_PAGE_ACCESS_TOKEN=
# ID da Página do Facebook
META_PAGE_ID=
# ID da conta Instagram Business conectada à Página
META_IG_USER_ID=
# Domínio do site já no ar — a Meta busca as imagens por URL pública
SITE_URL=https://seudominio.com.br

# Opcional: fixar a versão da Graph API (padrão v21.0)
# META_GRAPH_VERSION=v21.0

# --- Supabase (banco de dados do projeto) ---
# Token pessoal da conta (supabase.com/dashboard/account/tokens): dá acesso à Management API
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Senha do Postgres, gerada na criação do projeto
SUPABASE_DB_PASSWORD=
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
# Chave de serviço: ignora RLS. Só em script local, nunca no navegador nem na extensão
SUPABASE_SERVICE_ROLE_KEY=
